# 百度OCR配置
BAIDU_OCR_API_KEY=your_api_key_here
BAIDU_OCR_SECRET_KEY=your_secret_key_here

# 百度千帆大模型配置
BAIDUQIANFAN_API_KEY=your_api_key_here
BAIDUQIANFAN_SECRET_KEY=your_secret_key_here

# 百度AppBuilder Agent（可选）
APPBUILDER_API_URL=https://appbuilder.baidu.com/rpc/2.0/cloud_hub/v1/ai_engine/agi_platform/v1/instance/integrated
APPBUILDER_API_TOKEN=your_token_here
APPBUILDER_APP_ID=your_app_id_here
APPBUILDER_USER_ID=your_user_id_here
APPBUILDER_AK=
APPBUILDER_SK=

# 火山引擎 ARK（豆包大模型）
ARK_API_KEY=your_api_key_here
ARK_BOT_MODEL=your_bot_model_here
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/bots/chat/completions

# JWT认证配置（生产环境必须使用强随机密钥）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# 存储配置
STORAGE_PATH=./storage

# 数据库配置
DATABASE_URL=sqlite:///./contracts.db

# CORS配置（生产环境必须指定具体域名）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 环境标识
ENVIRONMENT=development

# 阿里云百炼（DashScope）配置
# DASHSCOPE_API_KEY: 百炼API密钥（sk-开头）
# DASHSCOPE_APP_ID: 通用智能体应用ID（同时用于合同解析和AI助手，除非分别配置下面两个）
# DASHSCOPE_CONTRACT_APP_ID: 合同解析专用智能体ID（可选，优先于DASHSCOPE_APP_ID）
# DASHSCOPE_AGENT_APP_ID: AI助手专用智能体ID（可选，优先于DASHSCOPE_APP_ID）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_APP_ID=your_app_id_here
DASHSCOPE_CONTRACT_APP_ID=
DASHSCOPE_AGENT_APP_ID=

# 钉钉机器人配置
DINGTALK_APP_KEY=your_app_key_here
DINGTALK_APP_SECRET=your_app_secret_here
DINGTALK_ROBOT_CODE=your_robot_code_here
DINGTALK_OUTGOING_TOKEN=your_outgoing_token_here
